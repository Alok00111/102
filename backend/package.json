{
    "name": "campus-placement-backend",
    "version": "1.0.0",
    "description": "Corporate-First Campus Placement Platform Backend",
    "main": "app.js",
    "scripts": {
        "start": "node app.js",
        "dev": "nodemon app.js",
        "db:setup": "psql -d campus_placement -f ../database/schema.sql",
